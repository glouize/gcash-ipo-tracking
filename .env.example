# ─── Reddit OAuth (free — register at https://www.reddit.com/prefs/apps) ───
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=gcash-ipo-tracker:v1.0 (by /u/your_reddit_username)

# ─── Discord Alerts (optional — create webhook in any Discord server channel) ─
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# ─── App Config ──────────────────────────────────────────────────────────────
# Currency display preference: PHP or USD
DISPLAY_CURRENCY=PHP
